# Copy this file to .env and adjust as needed.

# Model backend: "yolo" (real YOLO26n/YOLO11n, requires ultralytics+torch)
# or "fallback" (OpenCV Haar-cascade, no ML deps required -- NOT the real
# model, see backend/inference/fallback_engine.py).
VISIONAI_MODEL_BACKEND=yolo

# If VISIONAI_MODEL_BACKEND=yolo but ultralytics isn't installed, should the
# app silently degrade to the fallback engine instead of failing to start?
# Default false (fail loudly). Set true only for local dev without a full
# ML install.
VISIONAI_ALLOW_FALLBACK=false

# Minimum confidence for a YOLO detection to be returned.
VISIONAI_CONFIDENCE_THRESHOLD=0.25

# Backend
API_PORT=8000

# Frontend
VITE_API_BASE_URL=http://localhost:8000
